@using Riftcaster.Core.Network
@implements IDisposable
@inject NetworkAccess Network
@inject AccessCode AccessCode

@* The header's network access pill, which opens the network panel (issue #16). On the computer
   running the server, the panel switches network access and manages the access code. Remote
   operators only see whether network access is on, and can sign out: they can't switch it off,
   or change the code, so nobody can lock themselves (or everyone else) out. *@
<div class="network">
    <button type="button"
            class="pill @(Network.Enabled ? "on" : null)"
            aria-expanded="@(_open ? "true" : "false")"
            aria-controls="network-panel"
            @onclick="() => _open = !_open">
        <span class="dot" aria-hidden="true"></span>
        @(Network.Enabled ? "On network" : "Local only")
    </button>

    @if (_open)
    {
        @* Behind the panel, covering the page: a tap or click outside the panel closes it. *@
        <div class="scrim" aria-hidden="true" @onclick="Close"></div>

        <section id="network-panel" class="panel" aria-labelledby="network-title" @onkeydown="CloseOnEscape">
            <h2 id="network-title" class="title">Network access</h2>

            @if (Session.IsLocal)
            {
                <Toggle Label="Let other devices connect" Value="Network.Enabled" ValueChanged="Network.SetEnabled" />

                @if (Network.Enabled)
                {
                    var urls = Network.NetworkUrls();
                    if (urls.Count > 0)
                    {
                        <p class="text">Other devices on this network:</p>
                        <ul class="urls">
                            @foreach (var url in urls)
                            {
                                <li><span class="url-label">Overlays</span> <code>@url/overlays/…</code></li>
                                @if (AccessCode.IsSet)
                                {
                                    <li><span class="url-label">Web interface</span> <code>@url/</code></li>
                                }
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text warn">The server doesn't have a network address. Check that it's connected to the network.</p>
                    }
                    @* For any platform: not every firewall asks (Linux's usually block quietly), and those that
                       do name the program running the server: Riftcaster for the tray launcher, Riftcaster.Server
                       for the console server, dotnet when it's run from the source code. *@
                    <p class="text muted">If other devices can't connect, allow Riftcaster through the server's firewall. It may be listed as <strong>Riftcaster</strong>, <strong>Riftcaster.Server</strong>, or <strong>dotnet</strong>. You can also allow @PortsText.</p>
                }
                else
                {
                    <p class="text muted">Only the server can open the overlays and the web interface. Network access will always be off when the server starts.</p>
                }

                <p class="text muted">Turning network access on or off will briefly reconnect the web interface and every overlay.</p>

                <h3 class="subtitle">Access code</h3>
                @if (AccessCode.IsSet)
                {
                    <p class="text muted">Approved operators can sign in to the web interface with this code. Changing or removing the code will sign out every remote device.</p>
                    <div class="code-row">
                        <code class="code">@(_showCode ? AccessCode.Code : "••••••••")</code>
                        <button type="button" class="ghost" @onclick="() => _showCode = !_showCode">@(_showCode ? "Hide" : "Show")</button>
                    </div>
                }
                else
                {
                    <p class="text muted">No access code is set. The web interface will only be usable on the server. Set an access code to let approved operators sign in from remote devices.</p>
                }

                <div class="code-form">
                    <input type="text"
                           aria-label="@(AccessCode.IsSet ? "New access code" : "Access code")"
                           placeholder="@($"At least {AccessCode.MinLength} characters")"
                           autocomplete="off"
                           spellcheck="false"
                           @bind="_newCode"
                           @bind:event="oninput" />
                    <button type="button" class="ghost" @onclick="Generate">Generate</button>
                    <button type="button" class="primary" disabled="@string.IsNullOrWhiteSpace(_newCode)" @onclick="SetCode">@(AccessCode.IsSet ? "Change" : "Set")</button>
                </div>
                @if (_codeError)
                {
                    <p class="text warn" role="alert">Use @AccessCode.MinLength to @AccessCode.MaxLength characters (spaces and dashes don't count).</p>
                }

                <div class="actions">
                    @if (AccessCode.IsSet)
                    {
                        <button type="button" class="button-secondary" @onclick="RemoveCode">Remove code</button>
                    }
                    <span class="spacer"></span>
                    <button type="button" class="button-secondary" @onclick="Close">Done</button>
                </div>
            }
            else
            {
                <p class="text muted">Network settings can only be changed on the server.</p>

                <div class="actions">
                    @* A plain form post: signing out clears the sign-in cookie, which needs a real request. *@
                    <form method="post" action="/signout" data-enhance="false">
                        <button type="submit" class="button-secondary">Sign out</button>
                    </form>
                    <span class="spacer"></span>
                    <button type="button" class="button-secondary" @onclick="Close">Done</button>
                </div>
            }
        </section>
    }
</div>

@code {
    private bool _open;

    private bool _showCode;

    private string _newCode = "";

    private bool _codeError;

    [CascadingParameter]
    public OperatorSession Session { get; set; } = null!;

    // "port 5062", or "ports 5062 and 7216" when the server listens on more than one.
    private string PortsText
    {
        get
        {
            var ports = Network.ListenUrls.Select(url => url.Port).Distinct().ToList();
            return ports.Count == 1 ? $"port {ports[0]}" : $"ports {string.Join(" and ", ports)}";
        }
    }

    protected override void OnInitialized()
    {
        Network.Changed += OnChanged;
        AccessCode.Changed += OnChanged;
    }

    private void Close()
    {
        _open = false;
        _showCode = false;
    }

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    private void Generate()
    {
        _newCode = AccessCode.Generate();
        _codeError = false;
    }

    private void SetCode()
    {
        _codeError = !AccessCode.Set(_newCode);
        if (!_codeError)
        {
            _newCode = "";
            _showCode = true; // So it can be read out straight away
        }
    }

    private void RemoveCode()
    {
        AccessCode.Remove();
        _showCode = false;
    }

    private void OnChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Network.Changed -= OnChanged;
        AccessCode.Changed -= OnChanged;
    }
}
