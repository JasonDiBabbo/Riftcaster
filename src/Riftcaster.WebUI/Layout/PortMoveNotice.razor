@using Microsoft.JSInterop
@using Riftcaster.Contracts
@using Riftcaster.Core.Network
@implements IAsyncDisposable
@inject PortSwitcher Switcher
@inject ServerIdentity Identity
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* Shown on every page of the web interface, whoever has it open, while Riftcaster moves to another port: the
   page can't stay where it is, since its address has the old port in it. It says so, and goes to the new address
   by itself once the new port answers as this server. Renders nothing otherwise. *@

@if (_movingTo is { } port)
{
    <div class="moving" role="status">
        <b>Riftcaster is moving to port @port</b>
        <span>This page will move with it in a few seconds. If it doesn't, open <a href="@AddressOn(port)">@AddressOn(port)</a>.</span>
    </div>
}

@code {
    private IJSObjectReference? _module;

    private int? _movingTo;

    protected override void OnInitialized()
    {
        Switcher.Moving += OnMoving;
        Switcher.Changed += OnChanged;
    }

    // The page's own address, on the port it's moving to.
    private string AddressOn(int port)
    {
        var page = new Uri(Navigation.Uri);
        return $"{page.Scheme}://{page.Host}:{port}{page.PathAndQuery}";
    }

    private void OnMoving(int port)
    {
        _ = InvokeAsync(async () =>
        {
            _movingTo = port;
            StateHasChanged();

            // From here the page's own script does the following, which carries on after this connection is gone.
            await CallAsync("follow", port, Identity.StartTime.ToString("o"));
        });
    }

    private void OnChanged()
    {
        // Ended, and not on the port it was moving to: it couldn't, and is back where it was. Stay here.
        _ = InvokeAsync(async () =>
        {
            if (_movingTo is { } port && Switcher.SwitchingTo is null && Switcher.RunningPort != port)
            {
                _movingTo = null;
                StateHasChanged();
                await CallAsync("cancel");
            }
        });
    }

    private async Task CallAsync(string function, params object?[] arguments)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Riftcaster.WebUI/Layout/PortMoveNotice.razor.js");
            await _module.InvokeVoidAsync(function, arguments);
        }
        catch (Exception exception) when (exception is JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // The connection is gone (the old port closing): the page's script carries on without it.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Switcher.Moving -= OnMoving;
        Switcher.Changed -= OnChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Already gone with the connection.
            }
        }
    }
}
