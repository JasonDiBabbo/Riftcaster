@using Riftcaster.Core.LowerThird
@implements IDisposable
@inject LowerThirdService LowerThird

<Panel Title="Lower thirds" Meta="@SavedCount">
    <Actions>
        <button type="button" class="button-secondary" @onclick="StartNew">+ New</button>
    </Actions>
    <ChildContent>
        <div class="content">
            @if (_editor is not null)
            {
                <LowerThirdEditor @key="_editor.Key"
                                  Entry="_editor.Entry"
                                  OnSave="SaveEditor"
                                  OnCancel="CloseEditor" />
            }

            @{
                var library = LowerThird.Library;
            }
            @foreach (var entry in library.Entries)
            {
                <LowerThirdListItem @key="entry.Id"
                                    Entry="entry"
                                    IsLive="entry.Id == library.LiveEntryId"
                                    OnEdit="() => StartEdit(entry)"
                                    OnToggle="() => Toggle(entry.Id)"
                                    OnDelete="() => LowerThird.Delete(entry.Id)" />
            }
        </div>
    </ChildContent>
</Panel>

@code {
    // The open editor, if any. A new session (and so a new Key) each time + New or Edit is clicked.
    private EditorSession? _editor;

    private string SavedCount => $"{LowerThird.Library.Entries.Count} saved";

    protected override void OnInitialized()
    {
        LowerThird.Changed += OnLowerThirdChanged;
    }

    private void StartNew()
    {
        _editor = new EditorSession(Guid.NewGuid(), Entry: null);
    }

    private void StartEdit(LowerThirdEntry entry)
    {
        _editor = new EditorSession(Guid.NewGuid(), entry);
    }

    private void SaveEditor(LowerThirdMessage message)
    {
        // Update the entry being edited. If another tab deleted it meanwhile, keep the work as a new entry.
        var updated = _editor?.Entry is { } entry && LowerThird.Update(entry.Id, message);
        if (!updated)
        {
            LowerThird.Add(message);
        }

        _editor = null;
    }

    private void CloseEditor()
    {
        _editor = null;
    }

    private void Toggle(Guid id)
    {
        if (LowerThird.Library.LiveEntryId == id)
        {
            LowerThird.Hide();
        }
        else
        {
            LowerThird.Show(id);
        }
    }

    private void OnLowerThirdChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LowerThird.Changed -= OnLowerThirdChanged;
    }

    // Key: a fresh id per editor opening, used as the editor's @key so it starts fresh each time.
    // Entry: the entry being edited, or null for a new one.
    private sealed record EditorSession(Guid Key, LowerThirdEntry? Entry);
}
