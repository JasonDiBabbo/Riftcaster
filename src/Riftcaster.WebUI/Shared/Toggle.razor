<button type="button"
        class="toggle @(Value ? "on" : "") @(Bare ? "bare" : "")"
        role="switch"
        aria-checked="@(Value ? "true" : "false")"
        aria-label="@(Bare ? Label : null)"
        @onclick="() => ValueChanged.InvokeAsync(!Value)">
    <span class="label">@Label</span>
    <span class="track" aria-hidden="true">
        <span class="knob"></span>
    </span>
</button>

@code {
    /// <summary>
    /// The value of the toggle, i.e. on/true or off/false.
    /// </summary>
    [Parameter]
    public bool Value { get; set; }

    /// <summary>
    /// The callback for when the value changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// The toggle label.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// Draws just the switch, with no box or visible label, for a place that already says what it is
    /// (a row of the Settings page). The label is still what a screen reader hears.
    /// </summary>
    [Parameter]
    public bool Bare { get; set; }
}
