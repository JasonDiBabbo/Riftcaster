@using Riftcaster.Core.Match
@using Riftcaster.Core.Settings
@implements IDisposable
@inject MatchService Match
@inject AppSettingsService AppSettings

<FormSection Title="Match">
    <div class="fields">
      <div class="line">
        <div class="mode">
            <Field Label="Mode" Composite>
                <SegmentedControl Label="Mode"
                                  Options="MatchLabels.ModeOptions"
                                  @bind-Value:get="Match.Settings.Mode"
                                  @bind-Value:set="value => Match.Update(settings => settings with { Mode = value })" />
            </Field>
        </div>
        <div class="format">
            <Field Label="Format" Composite>
                <SegmentedControl Label="Format"
                                  Options="MatchLabels.FormatOptions"
                                  @bind-Value:get="Match.Settings.Format"
                                  @bind-Value:set="value => Match.Update(settings => settings with { Format = value })" />
            </Field>
        </div>
      </div>
      <div class="line">
        <div class="number">
            <Field Label="Points to win" Composite>
                <Stepper Label="Points to win"
                         Min="MatchService.MinPointsToWin"
                         Max="MatchService.MaxPointsToWin"
                         @bind-Value:get="Match.Settings.PointsToWin"
                         @bind-Value:set="value => Match.Update(settings => settings with { PointsToWin = value })" />
            </Field>
        </div>
        <div class="number">
            <Field Label="Duration (min)" Composite>
                <Stepper Label="Duration in minutes"
                         Min="MatchService.MinDurationMinutes"
                         Max="MatchService.MaxDurationMinutes"
                         Step="5"
                         @bind-Value:get="Match.Settings.DurationMinutes"
                         @bind-Value:set="value => Match.Update(settings => settings with { DurationMinutes = value })" />
            </Field>
        </div>
        <div class="overtime">
            <Toggle Label="Allow overtime"
                    @bind-Value:get="Match.Settings.AllowOvertime"
                    @bind-Value:set="value => Match.Update(settings => settings with { AllowOvertime = value })" />
        </div>
      </div>
      <div class="reset">
          @* About the whole form, not one of its fields, so it's under them. Nothing to do while the match
             already has the defaults, which are chosen on the Settings page. *@
          <button type="button" class="button-secondary" disabled="@(Match.Settings == AppSettings.MatchDefaults)" @onclick="() => Match.ResetToDefaults(AppSettings)">Reset to defaults</button>
      </div>
    </div>
</FormSection>

@code {
    protected override void OnInitialized()
    {
        Match.Changed += OnChanged;
        AppSettings.Changed += OnChanged; // The defaults, which the button compares with
    }

    private void OnChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Match.Changed -= OnChanged;
        AppSettings.Changed -= OnChanged;
    }
}
