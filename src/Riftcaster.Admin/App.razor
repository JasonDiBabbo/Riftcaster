@using Microsoft.AspNetCore.Http
@using Riftcaster.Core.Network
@inject AccessCode AccessCode
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <base href="/" />
        <link rel="icon" href="@Assets["_content/Riftcaster.Admin/logo/favicon.ico"]" sizes="32x32" />
        <link rel="icon" href="@Assets["_content/Riftcaster.Admin/logo/icon.svg"]" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="@Assets["_content/Riftcaster.Admin/logo/apple-touch-icon.png"]" />
        <link rel="stylesheet" href="@Assets["_content/Riftcaster.Admin/admin.css"]" />
        <link rel="stylesheet" href="@Assets["_content/Riftcaster.Admin/Riftcaster.Admin.bundle.scp.css"]" />
        <HeadOutlet @rendermode="InteractiveServer" />
    </head>
    <body>
        <Routes @rendermode="InteractiveServer" IsLocal="_isLocal" CodeVersion="@_codeVersion" />
        <ReconnectModal />
        <script src="_framework/blazor.web.js"></script>
    </body>
</html>

@code {
    // Rendered on the server for the page request, so this is the real connection (see OperatorSession).
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    private bool _isLocal;

    private string? _codeVersion;

    protected override void OnInitialized()
    {
        _isLocal = NetworkAccess.IsLocal(HttpContext.Connection.RemoteIpAddress);
        _codeVersion = AccessCode.Version;
    }
}
