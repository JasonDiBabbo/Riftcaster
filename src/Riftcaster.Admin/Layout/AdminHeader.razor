@using Riftcaster.Core.FeaturedCard
@using Riftcaster.Core.LowerThird
@using Riftcaster.Core.Match
@implements IDisposable
@inject FeaturedCardService FeaturedCard
@inject LowerThirdService LowerThird
@inject MatchService Match

<header class="header">
    <div class="brand">
        <span class="wordmark">RIFTCASTER</span>
        <span class="badge">ADMIN</span>
    </div>

    <div class="summary">@MatchLabels.Summary(Match.Settings)</div>

    <div class="spacer"></div>

    <div class="status">
        @if (FeaturedCard.Current is { } card)
        {
            <OnAirPill Label="Card" Text="@card.Name" MaxWidth="260" OnClear="FeaturedCard.Clear" />
        }
        @if (LowerThird.CurrentMessage is { } message)
        {
            <OnAirPill Label="Lower third" Text="@LowerThirdSummary.For(message).Primary" MaxWidth="280" OnClear="LowerThird.Hide" />
        }
        <div class="connected">
            <span class="dot"></span>Overlay connected
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        FeaturedCard.Changed += OnStateChanged;
        LowerThird.Changed += OnStateChanged;
        Match.Changed += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        FeaturedCard.Changed -= OnStateChanged;
        LowerThird.Changed -= OnStateChanged;
        Match.Changed -= OnStateChanged;
    }
}
