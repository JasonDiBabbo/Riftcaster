<section class="panel">
    <div class="header">
        <span class="tick"></span>
        <h2 class="title">@Title</h2>
        @if (Meta is not null)
        {
            <span class="meta">@Meta</span>
        }
        <div class="spacer"></div>
        @Actions
    </div>
    @Strip
    <div class="body">
        @ChildContent
    </div>
</section>

@code {
    /// <summary>
    /// The title of the panel.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>
    /// Meta information to render next to the title, such as a count or
    /// description of items in the panel.
    /// </summary>
    [Parameter]
    public string? Meta { get; set; }

    /// <summary>
    /// Actions to render in the header, such as buttons for creating or filtering items.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// The content to render inside the panel body.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Content between the header and body, such as the Players panel's scoreboard.
    /// It stays in place while the body scrolls.
    /// </summary>
    [Parameter]
    public RenderFragment? Strip { get; set; }
}
