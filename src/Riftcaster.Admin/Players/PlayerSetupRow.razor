@using Riftcaster.Core.Cards
@using Riftcaster.Core.Match
@using Riftcaster.Core.Players
@inject CardCatalog Catalog
@inject PlayersService Players

<div class="row" style="--player-hue: @PlayerLabels.Hue(Settings, Seat)">
    <div class="who">
        <span class="mark"></span>
        <span class="slot">@(Settings.IsTeamMode ? $"{PlayerLabels.TeamName(PlayerLabels.TeamOf(Seat))} · Player {Number}" : $"Player {Number}")</span>
    </div>
    <div class="name">
        <Field Label="Name">
            <input @bind:get="Player.Name" @bind:set="SetName" />
        </Field>
    </div>
    <div class="legend">
        <Field Label="Legend">
            <CardSelect Options="Catalog.Legends"
                        @bind-Value:get="Player.Legend"
                        @bind-Value:set="legend => Update(player => player with { Legend = legend })" />
        </Field>
    </div>
    <div class="champion">
        <Field Label="Champion">
            <CardSelect Options="CardChoices.ChampionsFor(Player.Legend, Catalog.ChampionUnits)"
                        @bind-Value:get="Player.Champion"
                        @bind-Value:set="champion => Update(player => player with { Champion = champion })" />
        </Field>
    </div>
    <div class="battlefield">
        <Field Label="Battlefield">
            <CardSelect Options="Catalog.Battlefields"
                        @bind-Value:get="Player.Battlefield"
                        @bind-Value:set="battlefield => Update(player => player with { Battlefield = battlefield })" />
        </Field>
    </div>
    <div class="swap">
        @* Swapping seats is how a player changes side, or team in 2v2. *@
        <Field Label="Swap seat">
            <select aria-label="@($"Swap player {Number} with")" @bind:get="NoSwap" @bind:set="SwapWith">
                <option value="@NoSwap">Swap with…</option>
                @foreach (var other in Enumerable.Range(0, Settings.PlayerCount).Where(other => other != Seat))
                {
                    <option value="@other">@PlayerLabels.Name(State.Players.Players[other], other)</option>
                }
            </select>
        </Field>
    </div>
</div>

@code {
    /// <summary>
    /// The player's seat, from 0.
    /// </summary>
    [Parameter, EditorRequired]
    public int Seat { get; set; }

    /// <summary>
    /// The match settings and players. The row shows the player in <see cref="Seat"/>; the settings
    /// decide its colour and label, and the other players fill "Swap with…".
    /// </summary>
    [Parameter, EditorRequired]
    public MatchState State { get; set; } = null!;

    // The "Swap with…" option's value. The select always shows it: picking a player swaps, then it resets.
    private const string NoSwap = "";

    // What the operator sees: seats count from 1.
    private int Number => Seat + 1;

    private Player Player => State.Players.Players[Seat];

    private MatchSettings Settings => State.Settings;

    // Sent when the field loses focus or Enter is pressed (the default for @bind on an input), not on
    // every keystroke, so the overlay never shows a half-typed name.
    private void SetName(string? name)
    {
        Update(player => player with { Name = name?.Trim() ?? "" });
    }

    private void SwapWith(string? other)
    {
        if (int.TryParse(other, out var seat))
        {
            Players.SwapPlayers(Seat, seat);
        }
    }

    private void Update(Func<Player, Player> change)
    {
        Players.UpdatePlayer(Seat, change);
    }
}
