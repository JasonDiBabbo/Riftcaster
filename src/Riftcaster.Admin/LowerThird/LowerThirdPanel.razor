@using System.ComponentModel.DataAnnotations
@using Riftcaster.Core.LowerThird
@implements IDisposable
@inject LowerThirdService LowerThird

<Panel Title="Lower thirds">
    <div class="content">
        <section>
            <h3>On air</h3>
            @switch (LowerThird.CurrentMessage)
            {
                case null:
                    <p>Nothing showing.</p>
                    break;
                case LowerThirdKeywordMessage keywordMessage:
                    <p><strong>@keywordMessage.Keyword</strong>: @keywordMessage.Description</p>
                    break;
                case var other:
                    <p>Showing a @other.GetType().Name.</p>
                    break;
            }
            <button class="button-secondary" @onclick="LowerThird.Hide" disabled="@(LowerThird.CurrentMessage is null)">Hide</button>
        </section>

        <section>
            <h3>Keyword Message</h3>

            <EditForm Model="_keywordMessageForm" OnValidSubmit="ShowKeyword">
                <DataAnnotationsValidator />
                <div class="fields">
                    <Field Label="Keyword">
                        <InputText @bind-Value="_keywordMessageForm.Keyword" />
                        <ValidationMessage For="() => _keywordMessageForm.Keyword" />
                    </Field>
                    <Field Label="Description">
                        <InputTextArea @bind-Value="_keywordMessageForm.Description" />
                        <ValidationMessage For="() => _keywordMessageForm.Description" />
                    </Field>

                    <div>
                        <button type="submit" class="button-secondary">Show</button>
                    </div>
                </div>
            </EditForm>
        </section>
    </div>
</Panel>

@code {
    private readonly KeywordMessageForm _keywordMessageForm = new();

    protected override void OnInitialized()
    {
        LowerThird.Changed += OnLowerThirdChanged;
    }

    private void ShowKeyword()
    {
        var message = new LowerThirdKeywordMessage(_keywordMessageForm.Keyword.Trim(), _keywordMessageForm.Description.Trim());
        var entry = LowerThird.Add(message);
        LowerThird.Show(entry.Id);
    }

    private void OnLowerThirdChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LowerThird.Changed -= OnLowerThirdChanged;
    }

    private sealed class KeywordMessageForm
    {
        [Required]
        public string Keyword { get; set; } = "";

        [Required]
        public string Description { get; set; } = "";
    }
}
