@using System.ComponentModel.DataAnnotations
@using Riftcaster.Core.LowerThird
@implements IDisposable
@inject LowerThirdService LowerThird

<Panel Title="Lower thirds">
    <div class="content">
        <section>
            <h3>On air</h3>
            @switch (LowerThird.CurrentMessage)
            {
                case null:
                    <p>Nothing showing.</p>
                    break;
                case LowerThirdKeywordMessage keywordMessage:
                    <p><strong>@keywordMessage.Keyword</strong>: @keywordMessage.Description</p>
                    break;
                case var other:
                    <p>Showing a @other.GetType().Name.</p>
                    break;
            }
            <button @onclick="LowerThird.Hide" disabled="@(LowerThird.CurrentMessage is null)">Hide</button>
        </section>

        <section>
            <h3>Keyword Message</h3>
            <EditForm Model="_keywordMessageForm" OnValidSubmit="ShowKeyword">
                <DataAnnotationsValidator />
                <p>
                    <label>Keyword <InputText @bind-Value="_keywordMessageForm.Keyword" /></label>
                    <ValidationMessage For="() => _keywordMessageForm.Keyword" />
                </p>
                <p>
                    <label>Description <InputTextArea @bind-Value="_keywordMessageForm.Description" /></label>
                    <ValidationMessage For="() => _keywordMessageForm.Description" />
                </p>
                <button type="submit">Show</button>
            </EditForm>
        </section>
    </div>
</Panel>

@code {
    private readonly KeywordMessageForm _keywordMessageForm = new();

    protected override void OnInitialized()
    {
        LowerThird.Changed += OnLowerThirdChanged;
    }

    private void ShowKeyword()
    {
        LowerThird.Show(
            new LowerThirdKeywordMessage(
                _keywordMessageForm.Keyword.Trim(),
                _keywordMessageForm.Description.Trim()));
    }

    private void OnLowerThirdChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LowerThird.Changed -= OnLowerThirdChanged;
    }

    private sealed class KeywordMessageForm
    {
        [Required]
        public string Keyword { get; set; } = "";

        [Required]
        public string Description { get; set; } = "";
    }
}
