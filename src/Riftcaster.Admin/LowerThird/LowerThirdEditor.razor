@using System.ComponentModel.DataAnnotations

<div class="editor">
    <span class="title">@(Entry is null ? "New lower third" : "Edit lower third")</span>

    <SegmentedControl @bind-Value="_kind" Options="KindOptions" Label="Type" />

    @switch (_kind)
    {
        case LowerThirdKind.Keyword:
            <EditForm Model="_keywordForm" OnValidSubmit="SaveKeywordAsync">
                <DataAnnotationsValidator />
                <div class="fields">
                    <InputText @bind-Value="_keywordForm.Keyword" placeholder="Keyword" aria-label="Keyword" />
                    <ValidationMessage For="() => _keywordForm.Keyword" />
                    <InputTextArea @bind-Value="_keywordForm.Description" placeholder="Description" aria-label="Description" rows="2" />
                    <ValidationMessage For="() => _keywordForm.Description" />
                    @Buttons
                </div>
            </EditForm>
            break;

        case LowerThirdKind.Information:
            <EditForm Model="_informationForm" OnValidSubmit="SaveInformationAsync">
                <DataAnnotationsValidator />
                <div class="fields">
                    <InputTextArea @bind-Value="_informationForm.Message" placeholder="Message" aria-label="Message" rows="2" />
                    <ValidationMessage For="() => _informationForm.Message" />
                    @Buttons
                </div>
            </EditForm>
            break;

        case LowerThirdKind.Socials:
            <EditForm Model="_socialsForm" OnValidSubmit="SaveSocialsAsync">
                <DataAnnotationsValidator />
                <div class="fields">
                    <div class="social-rows">
                        @foreach (var row in _socialsForm.Rows)
                        {
                            <div class="social-row" @key="row">
                                <InputSelect @bind-Value="row.Network" class="network" aria-label="Network">
                                    @foreach (var network in Enum.GetValues<SocialNetwork>())
                                    {
                                        <option value="@network">@network</option>
                                    }
                                </InputSelect>
                                <InputText @bind-Value="row.Handle" class="handle" placeholder="Handle or URL" aria-label="Handle" />
                                <button type="button" class="remove" aria-label="Remove" @onclick="() => RemoveRow(row)">×</button>
                            </div>
                        }
                    </div>
                    <button type="button" class="add" @onclick="AddRow">+ Add network</button>
                    <ValidationMessage For="() => _socialsForm.Rows" />
                    @Buttons
                </div>
            </EditForm>
            break;
    }
</div>

@code {
    private static readonly SegmentOption<LowerThirdKind>[] KindOptions =
    [
        new(LowerThirdKind.Keyword, "Keyword"),
        new(LowerThirdKind.Information, "Information"),
        new(LowerThirdKind.Socials, "Socials"),
    ];

    private readonly KeywordForm _keywordForm = new();

    private readonly InformationForm _informationForm = new();

    private readonly SocialsForm _socialsForm = new();

    private LowerThirdKind _kind = LowerThirdKind.Keyword;

    [Parameter]
    public LowerThirdEntry? Entry { get; set; }

    [Parameter]
    public EventCallback<LowerThirdMessage> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    // Shared by every type's form. A markup template stored in a property.
    private RenderFragment Buttons =>
        @<div class="buttons">
            <button type="button" class="cancel" @onclick="OnCancel">Cancel</button>
            <button type="submit" class="save">Save</button>
        </div>;

    // Once, not in OnParametersSet: the panel re-renders on every library change,
    // and re-copying the entry here would wipe whatever the operator is typing.
    protected override void OnInitialized()
    {
        switch (Entry?.Message)
        {
            case LowerThirdKeywordMessage keyword:
                _kind = LowerThirdKind.Keyword;
                _keywordForm.Keyword = keyword.Keyword;
                _keywordForm.Description = keyword.Description;
                break;
            case LowerThirdInformationMessage information:
                _kind = LowerThirdKind.Information;
                _informationForm.Message = information.Message;
                break;
            case LowerThirdSocialsMessage socials when socials.Links.Count > 0:
                _kind = LowerThirdKind.Socials;
                _socialsForm.Rows.Clear();
                _socialsForm.Rows.AddRange(socials.Links.Select(link => new SocialRow { Network = link.Network, Handle = link.Handle }));
                break;
        }
    }

    private Task SaveKeywordAsync() =>
        OnSave.InvokeAsync(new LowerThirdKeywordMessage(_keywordForm.Keyword.Trim(), _keywordForm.Description.Trim()));

    private Task SaveInformationAsync() =>
        OnSave.InvokeAsync(new LowerThirdInformationMessage(_informationForm.Message.Trim()));

    private Task SaveSocialsAsync()
    {
        // Rows with an empty handle are dropped.
        var links = _socialsForm.Rows
            .Where(row => !string.IsNullOrWhiteSpace(row.Handle))
            .Select(row => new SocialLink(row.Network, row.Handle.Trim()))
            .ToList();

        return OnSave.InvokeAsync(new LowerThirdSocialsMessage(links));
    }

    private void AddRow()
    {
        _socialsForm.Rows.Add(new SocialRow());
    }

    // The last row is cleared rather than removed, so there's always a row to type in.
    private void RemoveRow(SocialRow row)
    {
        if (_socialsForm.Rows.Count > 1)
        {
            _socialsForm.Rows.Remove(row);
        }
        else
        {
            row.Network = SocialNetwork.Twitch;
            row.Handle = "";
        }
    }

    private sealed class KeywordForm
    {
        [Required]
        public string Keyword { get; set; } = "";

        [Required]
        public string Description { get; set; } = "";
    }

    private sealed class InformationForm
    {
        [Required]
        public string Message { get; set; } = "";
    }

    // DataAnnotations only validate an object's own properties, not items inside a list,
    // so the "at least one handle" rule is written as whole-object validation instead.
    private sealed class SocialsForm : IValidatableObject
    {
        public List<SocialRow> Rows { get; } = [new SocialRow()];

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Rows.All(row => string.IsNullOrWhiteSpace(row.Handle)))
            {
                yield return new ValidationResult("Add at least one handle.", [nameof(Rows)]);
            }
        }
    }

    private sealed class SocialRow
    {
        public SocialNetwork Network { get; set; } = SocialNetwork.Twitch;

        public string Handle { get; set; } = "";
    }
}
