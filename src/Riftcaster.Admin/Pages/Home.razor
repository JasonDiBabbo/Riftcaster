@page "/"
@using Riftcaster.Core.Match
@implements IDisposable
@inject MatchService Match

<PageTitle>Riftcaster Dashboard</PageTitle>

<main class="dashboard" data-tab="@_tab" data-players="@Match.Settings.PlayerCount">
    <div class="column players-column">
        <div class="slot players-slot">
            <PlayersPanel />
        </div>
    </div>

    <div class="column match-column">
        <div class="slot timer-slot">
            <TimerPanel />
        </div>
        <div class="slot match-slot">
            <MatchPanel />
        </div>
    </div>

    <div class="column feature-column">
        <div class="slot cards-slot">
            <FeaturedCardPanel />
        </div>
        <div class="slot lower-thirds-slot">
            <LowerThirdPanel />
        </div>
    </div>
</main>

<DashboardTabBar @bind-Tab="_tab" />

@code {
    /// <summary>
    /// The visible tab, if applicable.
    /// </summary>
    /// <remarks>
    /// Wider screen layouts show every section and do not use tabs.
    /// </remarks>
    private DashboardTab _tab = DashboardTab.Players;

    protected override void OnInitialized()
    {
        // The player count sets the Players column's width on ultrawide screens.
        Match.Changed += OnMatchChanged;
    }

    private void OnMatchChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Match.Changed -= OnMatchChanged;
    }
}
