<Project Sdk="Microsoft.NET.Sdk">

  <!-- The XML doc comments become the descriptions of the REST API's responses in its OpenAPI
       document (see Riftcaster.Server). Not every type needs one, so missing comments aren't
       warnings (CS1591). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
