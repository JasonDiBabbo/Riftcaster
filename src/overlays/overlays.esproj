<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6578810">

  <!--
    IDE-only project: lists the overlays in Visual Studio's Solution Explorer with its npm and
    JavaScript tooling. It deliberately builds nothing. The real overlays build (npm ci, typecheck,
    bundle) lives in Riftcaster.Server.csproj, so it behaves the same in every IDE and the CLI.
    Safe to delete if this SDK ever causes trouble; the build doesn't depend on it.

    Starting this project (e.g. via the "Server + Overlay Watch" profile in Riftcaster.slnLaunch)
    runs the "Overlay watch" configuration in .vscode/launch.json: the overlay watcher, which
    rebuilds TS/CSS and re-copies assets on save.
  -->
  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>

    <!-- Lists the Vitest tests (src/**/*.test.ts) in Visual Studio's Test Explorer. IDE-only too:
         the build still runs them with npm test (see Riftcaster.Server.csproj).

         This is why package.json pins Vitest to 4.x: Visual Studio's Vitest helper (its own
         TestFrameworks\Vitest\VitestRunner.ts, as of VS 18.10) imports "vitest/runners", which
         Vitest 5 no longer exports, so discovery finds nothing. Upgrade Vitest once Visual Studio
         supports 5, and check the tests still appear in Test Explorer.

         Visual Studio only finds tests one level inside a describe block, so keep tests that way. -->
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
    <JavaScriptTestRoot>src\</JavaScriptTestRoot>
  </PropertyGroup>

</Project>
