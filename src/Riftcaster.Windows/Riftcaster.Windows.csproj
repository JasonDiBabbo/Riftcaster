<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The launcher people start, so it's Riftcaster.exe, not Riftcaster.Windows.exe (#68). -->
    <AssemblyName>Riftcaster</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets macOS and Linux compile it too, so dotnet build and dotnet test work on every machine.
     The exe only runs on Windows. A launcher for another platform will need per-platform builds
     instead (#69). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- dotnet run starts it in the server's folder, as the server's own dotnet run does, so in
     Development it finds appsettings.Development.json, the overlays and data/ there. -->
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)..\Riftcaster.Server</RunWorkingDirectory>
    <!-- The logo, made by tools/logo/build-icons.mjs. In File Explorer and the taskbar. -->
    <ApplicationIcon>Riftcaster.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the tray, read at the size Windows wants there. -->
    <EmbeddedResource Include="Riftcaster.ico" LogicalName="Riftcaster.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Riftcaster.Server\Riftcaster.Server.csproj" />
  </ItemGroup>

  <!-- Publishing: the server's own publish goes in the same folder. Only it has the dashboard's and
       overlays' files (wwwroot, overlays and its static web assets manifest), since a referenced
       project contributes just its assemblies. It also adds Riftcaster.Server.exe, the console
       server, which the release workflow's publish check starts. Same settings as this publish:
       the command line's properties (configuration, runtime, version, folder) pass on to it. -->
  <Target Name="PublishServer" AfterTargets="Publish">
    <MSBuild Projects="..\Riftcaster.Server\Riftcaster.Server.csproj" Targets="Publish" Properties="PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))" />
  </Target>

</Project>