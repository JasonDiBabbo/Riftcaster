<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- blazor.web.js is only included automatically for projects that contain .razor files;
       ours live in Riftcaster.Admin, so opt in explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- The XML doc comments on the REST API's request types become their descriptions in the
         OpenAPI document. Only the API's types need them, so missing comments elsewhere aren't
         warnings (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Riftcaster.Contracts\Riftcaster.Contracts.csproj" />
    <ProjectReference Include="..\Riftcaster.Admin\Riftcaster.Admin.csproj" />
    <ProjectReference Include="..\Riftcaster.Core\Riftcaster.Core.csproj" />
    <!-- Build order only: Codegen must regenerate the overlays' TypeScript types before
         BuildOverlays runs. Nothing from Codegen is referenced or copied into this project. -->
    <ProjectReference Include="..\..\tools\Riftcaster.Codegen\Riftcaster.Codegen.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The saved state (data/, see Storage:DataDirectory) is this computer's own: the access code,
       players and so on. Without this, the Web SDK would copy its .json files into every build
       and publish, handing them to anyone given the folder. -->
  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

  <!-- The REST API's OpenAPI document (/openapi/v1.json), and the Scalar page that shows it
       (/api/docs). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- The tests check internal pieces directly, such as which paths other devices may reach. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Riftcaster.Server.Tests" />
  </ItemGroup>

  <!--
    Overlays build (src/overlays): runs npm as part of every build of this project, from any IDE
    or `dotnet build`, so the served overlay pages are never stale. Each step is incremental and is
    skipped when its inputs haven't changed. Requires Node.js; pass -p:SkipOverlays=true to build
    only the .NET side. Skipped during Visual Studio's background (design-time) builds.
  -->
  <PropertyGroup>
    <OverlaysDir>$(MSBuildThisFileDirectory)..\overlays\</OverlaysDir>
    <OverlaysBuildStamp>$(OverlaysDir)dist\.build-stamp</OverlaysBuildStamp>
    <ShouldBuildOverlays Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipOverlays)' != 'true'">true</ShouldBuildOverlays>
  </PropertyGroup>

  <!-- Everything the checks and the bundle read: sources, plus the root files (package.json, the
       lockfile, tsconfig, build.mjs, and the lint and Prettier configs) and .vscode/, which
       format:check also covers. -->
  <ItemGroup>
    <OverlaysInput Include="$(OverlaysDir)src\**\*" />
    <OverlaysInput Include="$(OverlaysDir)*" />
    <OverlaysInput Include="$(OverlaysDir).vscode\**\*" />
  </ItemGroup>

  <Target Name="BuildOverlays" AfterTargets="Build" Condition="'$(ShouldBuildOverlays)' == 'true'"
          DependsOnTargets="EnsureNode;RestoreOverlayPackages;AuditOverlayPackages"
          Inputs="@(OverlaysInput)" Outputs="$(OverlaysBuildStamp)">
    <Message Importance="high" Text="Building overlays (typecheck + test + lint + format check + bundle)..." />
    <Exec Command="npm run typecheck" WorkingDirectory="$(OverlaysDir)" />
    <!-- Vitest (src/**/*.test.ts). NO_COLOR: like Prettier below, colored output shows up as raw
         escape codes in MSBuild logs. -->
    <Exec Command="npm test" WorkingDirectory="$(OverlaysDir)" EnvironmentVariables="NO_COLOR=1" />
    <!-- Lint and formatting problems fail the build like type errors do; the old repo ran these in a
         pre-commit hook, this runs them for everyone on every build (and in CI). Fix with
         `npm run lint:fix` and `npm run format`. -->
    <Exec Command="npm run lint" WorkingDirectory="$(OverlaysDir)" />
    <!-- no-color: Prettier's colored output shows up as raw escape codes in MSBuild logs. -->
    <Exec Command="npm run format:check -- --no-color" WorkingDirectory="$(OverlaysDir)" />
    <!-- build.mjs recreates dist/, which removes the stamp until this step succeeds. -->
    <Exec Command="npm run build" WorkingDirectory="$(OverlaysDir)" />
    <Touch Files="$(OverlaysBuildStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Publishing: the built overlays go in an overlays folder next to the server, where
       appsettings.json's Overlays:Path finds them. Added here, at publish time, because dist/ only
       exists once BuildOverlays has run. A publish without them (-p:SkipOverlays=true on a clean
       clone, say) fails: the result would serve no overlays. -->
  <Target Name="PublishOverlays" AfterTargets="ComputeResolvedFilesToPublishList">
    <Error Condition="!Exists('$(OverlaysBuildStamp)')"
           Text="The overlays aren't built ($(OverlaysDir)dist), so the publish would serve none. Publish without -p:SkipOverlays=true, or build once with Node.js installed first." />
    <ItemGroup>
      <OverlayDistFiles Include="$(OverlaysDir)dist\**\*" Exclude="$(OverlaysBuildStamp)" />
      <ResolvedFileToPublish Include="@(OverlayDistFiles)" RelativePath="overlays\%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!-- Reruns only when package-lock.json is newer than the last restore (switching branches counts,
       even with the same content), or node_modules is missing, e.g. a fresh clone.

       Locally this uses npm install, not npm ci. npm ci always deletes node_modules first, and
       Visual Studio keeps the overlays' own tsc.exe running as its TypeScript language server, so
       Windows refuses the delete and npm ci stops halfway, leaving node_modules broken. npm install
       only touches packages whose versions changed, so with an unchanged lockfile it's a no-op.
       A real TypeScript update still has to replace tsc.exe: if that fails, close Visual Studio
       and build again.

       CI (GitHub Actions sets CI=true) keeps npm ci: a clean install that also fails if the
       lockfile is out of step with package.json. -->
  <PropertyGroup>
    <OverlaysRestoreStamp>$(OverlaysDir)node_modules\.restore-stamp</OverlaysRestoreStamp>
  </PropertyGroup>
  <Target Name="RestoreOverlayPackages" Condition="'$(ShouldBuildOverlays)' == 'true'"
          Inputs="$(OverlaysDir)package-lock.json" Outputs="$(OverlaysRestoreStamp)">
    <Message Importance="high" Text="Installing overlay npm packages..." />
    <Exec Condition="'$(CI)' == 'true'" Command="npm ci" WorkingDirectory="$(OverlaysDir)" />
    <Exec Condition="'$(CI)' != 'true'" Command="npm install --no-audit --no-fund" WorkingDirectory="$(OverlaysDir)" />
    <!-- Our own stamp: npm install leaves its files alone when nothing changed, so they can't mark
         the restore as done. Inside node_modules, so deleting node_modules restores again. -->
    <Touch Files="$(OverlaysRestoreStamp)" AlwaysCreate="true" />
  </Target>

  <!-- npm audit, failing on high or critical advisories: an error in CI, a warning locally (it shows
       in Visual Studio's Error List). Run `npm audit` in src/overlays for the details any time.

       It asks the npm registry, so locally it runs at most once a day, and again whenever the
       lockfile changes. Only a clean audit is recorded, so a warning comes back on every build
       until it's fixed (or, offline, until the registry can be reached again). CI keeps nothing
       between runs, so it always audits. -->
  <PropertyGroup>
    <OverlaysAuditStamp>$(OverlaysDir)node_modules\.audit-stamp</OverlaysAuditStamp>
  </PropertyGroup>
  <Target Name="AuditOverlayPackages" DependsOnTargets="RestoreOverlayPackages" Condition="'$(ShouldBuildOverlays)' == 'true'">
    <PropertyGroup>
      <OverlaysAuditDue>true</OverlaysAuditDue>
      <OverlaysAuditDue Condition="'$(CI)' != 'true' and Exists('$(OverlaysAuditStamp)')
          and $([System.IO.File]::GetLastWriteTime('$(OverlaysAuditStamp)').AddDays(1).Ticks) &gt; $([System.DateTime]::Now.Ticks)
          and $([System.IO.File]::GetLastWriteTime('$(OverlaysAuditStamp)').Ticks) &gt;= $([System.IO.File]::GetLastWriteTime('$(OverlaysDir)package-lock.json').Ticks)">false</OverlaysAuditDue>
    </PropertyGroup>

    <Exec Condition="'$(OverlaysAuditDue)' == 'true'" Command="npm audit --audit-level=high --color=false"
          WorkingDirectory="$(OverlaysDir)" IgnoreExitCode="true" StandardOutputImportance="high">
      <Output TaskParameter="ExitCode" PropertyName="OverlaysAuditExitCode" />
    </Exec>

    <Error Condition="'$(OverlaysAuditDue)' == 'true' and '$(OverlaysAuditExitCode)' != '0' and '$(CI)' == 'true'"
           Text="npm audit found high or critical advisories in the overlay packages (see above). Fix them with `npm audit fix` or an update in src/overlays." />
    <Warning Condition="'$(OverlaysAuditDue)' == 'true' and '$(OverlaysAuditExitCode)' != '0' and '$(CI)' != 'true'"
             Text="npm audit found high or critical advisories in the overlay packages, or couldn't reach the npm registry. Run `npm audit` in src/overlays for details. This warning repeats on every build until the audit passes." />
    <Touch Condition="'$(OverlaysAuditDue)' == 'true' and '$(OverlaysAuditExitCode)' == '0'" Files="$(OverlaysAuditStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Points Git at the repository's committed hooks in .githooks/ (see pre-commit there), so every
       clone gets them after its first build with nothing to install. Only changes this clone's own
       .git/config. Skipped outside a Git checkout (e.g. a source zip), in CI (GitHub Actions sets
       CI=true), and in Visual Studio's background builds; a missing git is a warning, not an error. -->
  <Target Name="InstallGitHooks" BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(CI)' != 'true' and Exists('$(MSBuildThisFileDirectory)..\..\.git')">
    <Exec Command="git config core.hooksPath .githooks" WorkingDirectory="$(MSBuildThisFileDirectory)..\.."
          ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <Target Name="EnsureNode" Condition="'$(ShouldBuildOverlays)' == 'true'">
    <Exec Command="node --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0'"
           Text="Node.js (22.18 or later) is required to build the overlays in $(OverlaysDir). Install it from https://nodejs.org, or build with -p:SkipOverlays=true to skip them." />
  </Target>

</Project>
