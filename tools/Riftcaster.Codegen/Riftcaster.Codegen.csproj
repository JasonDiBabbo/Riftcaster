<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Riftcaster.Contracts\Riftcaster.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TypeGen 7's net10.0 package omits its dependencies; remove once fixed upstream. -->
    <PackageReference Include="Namotion.Reflection" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="TypeGen" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratedTypesDir>$(MSBuildThisFileDirectory)..\..\src\overlays\src\generated\</GeneratedTypesDir>
    <GeneratedTypesStamp>$(GeneratedTypesDir).codegen-stamp</GeneratedTypesStamp>
  </PropertyGroup>

  <!--
    Regenerates the TypeScript types after each build, but only when this tool or the Contracts
    assembly changed. Skipping unchanged runs keeps the generated files' timestamps stable, which
    lets the overlays build in Riftcaster.Server.csproj skip itself too. The stamp lives inside the
    output folder, so deleting that folder always forces a regeneration.
  -->
  <Target Name="GenerateTypeScript" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(TargetPath);$(OutDir)Riftcaster.Contracts.dll" Outputs="$(GeneratedTypesStamp)">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(GeneratedTypesDir.TrimEnd('\'))&quot;" />
    <Touch Files="$(GeneratedTypesStamp)" AlwaysCreate="true" />
  </Target>

</Project>
