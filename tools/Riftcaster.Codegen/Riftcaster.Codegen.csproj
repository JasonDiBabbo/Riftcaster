<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Riftcaster.Contracts\Riftcaster.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TypeGen 7's net10.0 package omits its dependencies; remove once fixed upstream. -->
    <PackageReference Include="Namotion.Reflection" Version="2.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="TypeGen" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <Target Name="GenerateTypeScript" AfterTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(MSBuildThisFileDirectory)../../src/overlays/src/generated&quot;" />
  </Target>

</Project>
